@ARTICLE{Fantl2021645,
	author = {Fantl, Jeremy},
	title = {Fake News vs. Echo Chambers},
	year = {2021},
	journal = {Social Epistemology},
	volume = {35},
	number = {6},
	pages = {645 - 659},
	doi = {10.1080/02691728.2021.1946201},
	url = {https://www.scopus.com/pages/publications/85109348469?origin=resultslist},
	affiliations = {Department of Philosophy, University of Calgary, Calgary, Canada},
	abstract = {I argue that there is a prima facie tension between solutions to the problem of fake news and solutions to the problem presented by various cognitive biases that dispose us to dismiss evidence against our prior beliefs (what might seem to be the driving force behind echo chambers). We can guard against fake news by strengthening belief. But we can exit echo chambers by becoming more sensitive to counterevidence, which seems to require weakening our beliefs. I resolve the tension by arguing against an injunction to weaken belief in the required ways. In particular, there is no injunction to be open-minded in all circumstances toward various counterarguments, even those whose premises seem compelling and in which we can’t expose a flaw. On the contrary, there are circumstances in which you should, in the relevant sense, be closed-minded toward such counterarguments. © 2021 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {attitude-certainty; belief; Echo chambers; fake news; open-mindedness},
