	abstract = {Information overload that affects digital natives and other generations in the 21st century makes it difficult for recipients to analyze the information’s truthfulness and quality. In this context, items of fake news pass as facts that could be interpreted as true, which may result in serious issues for the social fabric, especially if immersed in unstable or troublesome political and economic contexts. Still, the problem with disinformation is not limited to fake news because, even when content comes from trustworthy sources and verifiable facts, there are filters that present a subjective, biased and deformed reality. Within this context, we are submitting an example of a positive practice in media literacy targeting Research Methodology students at the Faculty of Communication. During this project, students analyzed the way women and men are shown on the cover of a local printed newspaper El Porvenir in the city of Monterrey, Mexico. In broad strokes, the results found a preference for stories showcasing men and stereotypes that place men in the public sphere and women in a private domain. © 2019, University of Zagreb. All rights reserved.},
	author_keywords = {Biased information; Fake news; Gender stereotypes; MIL; News articles; Trustworthy source},
	publisher = {Faculty of Political Sciences, University of Zagreb},
	issn = {18479758},
	language = {English},
	abbrev_source_title = {Medijske Stud.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access}
}

@ARTICLE{Riva20197,
	author = {Riva, Gianluigi M. and Barry, Marguerite},
	title = {Net neutrality matters: Privacy antibodies for information monopolies and mass profiling; [Neutralidade da rede importa: Anticorpos de privacidade para monopólios de informação e profiling em massa]},
	year = {2019},
	journal = {Publicum},
	volume = {5},
	number = {2},
	pages = {7 - 35},
	doi = {10.12957/publicum.2019.47199},
	url = {https://www.scopus.com/pages/publications/85078040396?origin=resultslist},
	affiliations = {University College Dublin, School of Information and Communications Studies, Dublin, Ireland},
	abstract = {Profiling activities used to personalise user content can place online corporations in a position of significant influence over user behaviour. The ability to deliver different search engine results, news feeds, discriminatory prices, and so forth, can be exploited to grant unequal access to different kinds of content. This is likely to intensify with the Internet of Things (IoT), which will surround individuals with sensors capable of 24/7 full tracking. This content-shaping power jeopardises the neutral accessibility that a democratic internet should ensure. Indeed, both neutrality and accessibility should refer not only to the service connection but also to the content it delivers. This study examines this personalisation and filtering power in light of Privacy and Data Protection regulations to explore how privacy principles can be used to enhance IoT accessibility. It elaborates a comparative analysis of legislative sources related to public goods and interests, data flows and contract law relationships, into a holistic narrative reasoning. The discussion addresses the monopolistic economic position of platforms, their connected revenue models and the power to control and influence information. Fake news plays a crucial role in this and is addressed consequently. Therefore, the study analyses how these factors together could form profiling ‘multi-monopolies’ in connection with a non-neutral Internet of Things. Furthermore, techniques of influence have more grip where there is a lack of awareness and knowledge, and a new model of digital “divide et impera” seems to enhance these phenomena. Besides, social score systems and discriminatory pricing can be powerful tools in this sense. We discuss the gap between regulatory approaches and real-world situations, offering common legal tools and Privacy by Design (PbD) as potential solutions for neutral accessibility. We highlight how the current regulatory framework requires more harmonisation to guarantee effective user protections, especially in an IoT ecosystem. © 2019, Universidade do Estado do Rio de Janeiro. All rights reserved.},
	author_keywords = {Discriminatory pricing; Fake news; IoT; Net Neutrality; Privacy by Design; Profiling; Social credit system},
	publisher = {Universidade do Estado do Rio de Janeiro},
	issn = {24477982},
	language = {English},
	abbrev_source_title = {Publicum},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access; Gold Open Access}
}

