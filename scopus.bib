@ARTICLE{Pongiglione2021243,
	author = {Pongiglione, Francesca},
	title = {FALSE CREDENZE E COLPEVOLEZZA NEI CONTESTI SOCIALI VIRTUALI},
	year = {2021},
	journal = {Sistemi Intelligenti},
	volume = {33},
	number = {2},
