	author = {Walter, Nathan and Cohen, Jonathan and Holbert, R. Lance and Morag, Yasmin},
	title = {Fact-Checking: A Meta-Analysis of What Works and for Whom},
	year = {2020},
	journal = {Political Communication},
	volume = {37},
