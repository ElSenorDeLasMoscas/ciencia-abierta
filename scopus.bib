	publisher = {Springer Netherlands},
	issn = {15981037},
	language = {English},
	abbrev_source_title = {Asia Pac. Educ. Rev.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 14; All Open Access; Hybrid Gold Open Access}
}

