	title = {Stop and Think! Exploring the Role of News Truth Discernment, Information Literacy, and Impulsivity in the Effect of Critical Thinking Recommendations on Trust in Fake Covid-19 News},
	year = {2022},
	journal = {European Journal of Health Communication},
	volume = {3},
