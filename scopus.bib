@ARTICLE{Hadlington202240,
	author = {Hadlington, Lee and Harkin, Lydia J. and Kuss, Daria and Newman, Kristina and Ryding, Francesca C.},
	title = {Perceptions of Fake News, Misinformation, and Disinformation Amid the COVID-19 Pandemic: A Qualitative Exploration},
	year = {2022},
	journal = {Psychology of Popular Media},
	volume = {12},
