	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 162}
}

@ARTICLE{Elisabetta Galeotti2022703,
	author = {Elisabetta Galeotti, Anna and Meini, Cristina},
	title = {Scientific Misinformation and Fake News: A Blurred Boundary},
	year = {2022},
	journal = {Social Epistemology},
	volume = {36},
	number = {6},
