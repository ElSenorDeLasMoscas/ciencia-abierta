	title = {A framework for detecting injected influence attacks on microblog websites using change detection techniques},
	year = {2018},
	journal = {Development Engineering},
	volume = {3},
	pages = {218 - 233},
	doi = {10.1016/j.deveng.2018.08.002},
	url = {https://www.scopus.com/pages/publications/85053307578?origin=resultslist},
	affiliations = {Santa Clara University, United States},
	abstract = {Presidential elections can impact world peace, global economics, and overall well-being. Recent news indicates that fraud on the Web has played a substantial role in elections, particularly in developing countries in South America and the public discourse, in general. To protect the trustworthiness of the Web, in this paper, we present a novel framework using statistical techniques to help detect veiled Web fraud attacks in Online Social Networks (OSN). Specific examples are used to demonstrate how some statistical techniques, such as the Kalman Filter and the modified CUSUM, can be applied to detect various attack scenarios. A hybrid data set, consisting of both real user tweets collected from Twitter and simulated fake tweets is constructed for testing purposes. The efficacy of the proposed framework has been verified by computing metrics, such as Precision, Recall, and Area Under the ROC curve. The algorithms achieved up to 99.9% accuracy in some scenarios and are over 80% accurate for most of the other scenarios. © 2018 The Authors},
	author_keywords = {Attack injection; Cumulative sum; Discrete Kalman Filter; Microblogging; Online Social Networks; Sentiment analysis; Twitter bot},
	correspondence_address = {V.S. Pendyala; Santa Clara University, United States; email: vpendyala@scu.edu},
	publisher = {Elsevier Ltd},
	issn = {23527285},
	language = {English},
