@ARTICLE{Meppelink2022764,
	author = {Meppelink, Corine S. and Bos, Linda and Boukes, Mark and Möller, Judith},
	title = {A Health Crisis in the Age of Misinformation: How Social Media and Mass Media Influenced Misperceptions about COVID-19 and Compliance Behavior},
	year = {2022},
	journal = {Journal of Health Communication},
	volume = {27},
