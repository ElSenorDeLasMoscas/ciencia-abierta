@ARTICLE{Rapeli20211683,
	author = {Rapeli, Lauri and Nieminen, Sakari and Mäkelä, Marko},
	title = {Not just the facts: an index for measuring the information density of political communication},
	year = {2021},
	journal = {Quality and Quantity},
	volume = {55},
	number = {5},
	pages = {1683 - 1702},
	doi = {10.1007/s11135-020-01075-6},
	url = {https://www.scopus.com/pages/publications/85097168893?origin=resultslist},
	affiliations = {The Social Science Research Institute, Åbo Akademi University, Fänriksgatan 3 ASA A4, Åbo Finland, 20500, Finland; Department of Philosophy, Contemporary History and Political Science, University of Turku, Turku, Finland; Department of Mathematics and Statistics, University of Turku, Turku, Finland},
	abstract = {Misinformation and biased opinion-formation plague contemporary politics. Fact-checking, the process of verifying accuracy of political claims, is now an expanding reseach area, but the methodology is underdeveloped. While the journalistic practice of fact-checking is by now well-established as an integral part of political news coverage, academic research requires more stringent methods than what journalists thus far have used. In order to advance the scientific study of fact-checking, we propose two variants of an index measuring the information density of verbal political communication. The main index combines three dimensions: (1) factual accuracy of political claims, (2) their relevance and (3) the magnitude of observed communication. In the article, we argue for the significance of each of these components. Depending on the research problem and data, the indices can be used for comparisons of political actors across different contexts such as countries or time points, or in non-comparative situations. Using examples, we demonstrate that the indices produce intuitive results. © 2020, The Author(s).},
	author_keywords = {Fact-checking; Index; Information density; Political communication; Political rhetoric},
	correspondence_address = {L. Rapeli; The Social Science Research Institute, Åbo Akademi University, Åbo Finland, Fänriksgatan 3 ASA A4, 20500, Finland; email: lauri.rapeli@abo.fi},
