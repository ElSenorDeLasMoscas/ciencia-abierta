@ARTICLE{García2021293,
	author = {García, César},
	title = {When an Efficient Use of Strategic Communication (Public Diplomacy and Public Relations) to Internationalize a Domestic Conflict Is Not Enough to Gain International Political Support: The Catalan Case (2012-2017)},
