@ARTICLE{Herrero-Diz2020,
	author = {Herrero-Diz, Paula and Conde-Jiménez, Jesús and Reyes de Cózar, Salvador},
	title = {Teens’ Motivations to Spread Fake News on WhatsApp},
	year = {2020},
	journal = {Social Media and Society},
	volume = {6},
	number = {3},
	pages = {},
