	title = {Some Findings Regarding the Chain of Narrators (Sanad) and Textual Content (Matn) Evaluation of the Reports About the Barking of Hawaab Dogs; [Hav'eb Köpeklerinin Havlaması Olayıyla İlgili Rivâyetlerin Sened ve Muhteva Değerlendirmesine Dâir Bazı Tespitler]},
	year = {2021},
	journal = {Cumhuriyet Ilahiyat Dergisi},
