	keywords = {Classification (of information); Data mining; Learning algorithms; Sentiment analysis; Surveys; Detection methods; Natural languages; Opinion mining; Research interests; Sentiment analysis; Social media; Stance; Stance classification; Stance detection; State of the art; Social networking (online)},
