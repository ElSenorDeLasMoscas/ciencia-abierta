@ARTICLE{Ali2022379,
	author = {Ali, Khudejah and Li, Cong and Zain-ul-abdin, Khawaja and Zaffar, Muhammad Adeel},
	title = {Fake news on Facebook: examining the impact of heuristic cues on perceived credibility and sharing intention},
	year = {2022},
	journal = {Internet Research},
	volume = {32},
	number = {1},
	pages = {379 - 397},
	doi = {10.1108/INTR-10-2019-0442},
	url = {https://www.scopus.com/pages/publications/85111394012?origin=resultslist},
	affiliations = {Suleman Dawood School of Business, Lahore University of Management Sciences, Lahore, Pakistan; School of Communication, University of Miami, Coral Gables, FL, United States},
	abstract = {Purpose: As the epidemic of online fake news is causing major concerns in contexts such as politics and public health, the current study aimed to elucidate the effect of certain “heuristic cues,” or key contextual features, which may increase belief in the credibility and the subsequent sharing of online fake news. Design/methodology/approach: This study employed a 2 (news veracity: real vs fake) × 2 (social endorsements: low Facebook “likes” vs high Facebook “likes”) between-subjects experimental design (N = 239). Findings: The analysis revealed that a high number of Facebook “likes” accompanying fake news increased the perceived credibility of the material compared to a low number of “likes.” In addition, the mediation results indicated that increased perceptions of news credibility may create a situation in which readers feel that it is necessary to cognitively elaborate on the information present in the news, and this active processing finally leads to sharing. Practical implications: The results from this study help explicate what drives increased belief and sharing of fake news and can aid in refining interventions aimed at combating fake news for both communities and organizations. Originality/value: The current study expands upon existing literature, linking the use of social endorsements to perceived credibility of fake news and information, and sheds light on the causal mechanisms through which people make the decision to share news articles on social media. © 2021, Emerald Publishing Limited.},
	author_keywords = {Facebook; Fake news; Heuristic systematic model; News credibility; News sharing},
	correspondence_address = {K. Ali; Suleman Dawood School of Business, Lahore University of Management Sciences, Lahore, Pakistan; email: k.ali@lums.edu.pk},
