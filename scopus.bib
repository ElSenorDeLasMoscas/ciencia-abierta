@ARTICLE{Schuetz2021376,
	author = {Schuetz, Sebastian W. and Sykes, Tracy Ann and Venkatesh, Viswanath},
	title = {Combating COVID-19 fake news on social media through fact checking: antecedents and consequences},
	year = {2021},
	journal = {European Journal of Information Systems},
	volume = {30},
