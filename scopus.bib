@ARTICLE{Edenborg2022496,
	author = {Edenborg, Emil},
	title = {Disinformation and gendered boundarymaking: Nordic media audiences making sense of “Swedish decline”},
	year = {2022},
	journal = {Cooperation and Conflict},
	volume = {57},
