}

@ARTICLE{Singh20213,
	author = {Singh, Vivek K. and Ghosh, Isha and Sonagara, Darshan},
	title = {Detecting fake news stories via multimodal analysis},
	year = {2021},
	journal = {Journal of the Association for Information Science and Technology},
	volume = {72},
	number = {1},
	pages = {3 - 17},
