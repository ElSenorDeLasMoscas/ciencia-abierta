	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 15; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Stecula2021,
	author = {Stecula, Dominik A. and Pickup, Mark},
	title = {Social Media, Cognitive Reflection, and Conspiracy Beliefs},
	year = {2021},
