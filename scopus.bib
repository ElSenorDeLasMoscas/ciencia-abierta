@ARTICLE{Campinho2019232,
	author = {Campinho, Bernardo Brasil},
	title = {Constitution, democracy, regulation of the internet and electoral fake news in the Brazilian elections; [Constituição, democracia, regulação da internet e fake news nas eleições brasileiras]},
	year = {2019},
