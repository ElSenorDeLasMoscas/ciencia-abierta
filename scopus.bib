@ARTICLE{Freeze20211433,
	author = {Freeze, Melanie and Baumgartner, Mary and Bruno, Peter and Gunderson, Jacob R. and Olin, Joshua and Ross, Morgan Quinn and Szafran, Justine},
	title = {Fake Claims of Fake News: Political Misinformation, Warnings, and the Tainted Truth Effect},
	year = {2021},
	journal = {Political Behavior},
	volume = {43},
	number = {4},
	pages = {1433 - 1465},
	doi = {10.1007/s11109-020-09597-3},
	url = {https://www.scopus.com/pages/publications/85079504362?origin=resultslist},
	affiliations = {Department of Political Science, Carleton College, One North College Street, Northfield, 55057, MN, United States; Minneapolis, United States; Washington, United States; Department of Political Science, University of North Carolina at Chapel Hill, 361 Hamilton Hall, CB 3265, Chapel Hill, 27599-3265, NC, United States; New York, United States; School of Communication, Ohio State University, 3016 Derby Hall, 154 N Oval Mall, Columbus, 43210, OH, United States; Wilmette, United States},
	abstract = {Fact-checking and warnings of misinformation are increasingly salient and prevalent components of modern news media and political communications. While many warnings about political misinformation are valid and enable people to reject misleading information, the quality and validity of misinformation warnings can vary widely. Replicating and extending research from the fields of social cognition and forensic psychology, we find evidence that valid retrospective warnings of misleading news can help individuals discard erroneous information, although the corrections are weak. However, when informative news is wrongly labeled as inaccurate, these false warnings reduce the news’ credibility. Invalid misinformation warnings taint the truth, lead individuals to discard authentic information, and impede political memory. As only a few studies on the tainted truth effect exist, our research helps to illuminate the less explored dark side of misinformation warnings. Our findings suggest general warnings of misinformation should be avoided as indiscriminate use can reduce the credibility of valid news sources and lead individuals to discard useful information. © 2020, The Author(s).},
	author_keywords = {Fake news; Misinformation; Tainted truth effect; Warnings},
	correspondence_address = {M. Freeze; Department of Political Science, Carleton College, Northfield, One North College Street, 55057, United States; email: mfreeze@carleton.edu},
