@ARTICLE{Ross2022786,
	author = {Ross, Andrew R. N. and Vaccari, Cristian and Chadwick, Andrew},
	title = {Russian Meddling in U.S. Elections: How News of Disinformation’s Impact Can Affect Trust in Electoral Outcomes and Satisfaction with Democracy},
