@ARTICLE{Wischnewski2021549,
	author = {Wischnewski, Magdalena and Bruns, Axel and Keller, Tobias},
	title = {Shareworthiness and Motivated Reasoning in Hyper-Partisan News Sharing Behavior on Twitter},
	year = {2021},
	journal = {Digital Journalism},
	volume = {9},
	number = {5},
	pages = {549 - 570},
	doi = {10.1080/21670811.2021.1903960},
	url = {https://www.scopus.com/pages/publications/85103611103?origin=resultslist},
	affiliations = {Social Psychology: Media and Communication, University of Duisburg-Essen, Duisburg, Germany; Digital Media Research Centre, Queensland University of Technology, Brisbane, QLD, Australia; gfs.bern, Bern, Switzerland},
	abstract = {While news sharing by ordinary social media users has received growing attention, hyper-partisan news sharing, which has been closely associated with misinformation circulation, has received less attention. In this study, we investigate hyper-partisan news sharing from two perspectives: (1) the features that make hyper-partisan news share-worthy, as well as (2) the user motivations that drive the sharing process. We scrutinize one week’s content from Infowars.com as it was shared on Twitter. Through both manual coding of news content and semi-automated clustering of Twitter account descriptions, we find that human interest and conflict in news stories drive the sharing process from a content perspective. Concerning the user perspective, we find partial support for a sharing hypothesis based on motivated reasoning, which indicates that users are more likely to share hyper-partisan news stories if these align with their own political opinions. © 2021 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {hyper-partisan news; Infowars; motivated reasoning; News sharing; popularity cues; shareworthiness},
	publisher = {Routledge},
	issn = {21670811},
	language = {English},
	abbrev_source_title = {Digit. Journal.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 24}
}

