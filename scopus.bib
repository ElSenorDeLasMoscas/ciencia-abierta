	note = {Cited by: 5}
}

@ARTICLE{Almansa-Martínez2022183,
	author = {Almansa-Martínez, Ana and Fernández-Torres, María Jesús and Rodríguez-Fernández, Leticia},
	title = {Disinformation in Spain one year after COVID-19. Analysis of the Newtral and Maldita verifications; [Desinformación en España un año después de la COVID-19. Análi-sis de las verificaciones de Newtral y Maldita]},
	year = {2022},
	journal = {Revista Latina de Comunicacion Social},
