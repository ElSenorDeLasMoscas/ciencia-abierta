@ARTICLE{Hameleers2022110,
	author = {Hameleers, Michael},
	title = {Separating truth from lies: comparing the effects of news media literacy interventions and fact-checkers in response to political misinformation in the US and Netherlands},
	year = {2022},
	journal = {Information Communication and Society},
	volume = {25},
