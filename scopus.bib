@ARTICLE{Jahanbakhsh2022,
	author = {Jahanbakhsh, Farnaz and Zhang, Amy X. and Karger, David R.},
	title = {Leveraging Structured Trusted-Peer Assessments to Combat Misinformation},
	year = {2022},
	journal = {Proceedings of the ACM on Human-Computer Interaction},
	volume = {6},
