	issn = {2297900X},
	language = {English},
	abbrev_source_title = {Front. Commun.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Dietrich2022135,
