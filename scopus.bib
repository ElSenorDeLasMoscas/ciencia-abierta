@ARTICLE{Neo20221919,
	author = {Neo, Ric},
	title = {A cudgel of repression: Analysing state instrumentalisation of the ‘fake news’ label in Southeast Asia},
	year = {2022},
	journal = {Journalism},
	volume = {23},
