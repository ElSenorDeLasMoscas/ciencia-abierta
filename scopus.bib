@ARTICLE{Muddiman2022174,
	author = {Muddiman, Ashley and Budak, Ceren and Murray, Caroline and Kim, Yujin and Stroud, Natalie Jomini},
	title = {Indexing theory during an emerging health crisis: how U.S. TV news indexed elite perspectives and amplified COVID-19 misinformation},
	year = {2022},
	journal = {Annals of the International Communication Association},
	volume = {46},
	number = {3},
	pages = {174 - 204},
	doi = {10.1080/23808985.2022.2120521},
	url = {https://www.scopus.com/pages/publications/85140999868?origin=resultslist},
	affiliations = {Communication Studies Department, University of Kansas, Lawrence, KS, United States; Center for Media Engagement, Moody College of Communication, University of Texas at Austin, Austin, TX, United States; School of Information, University of Michigan, Ann Arbor, MI, United States; Communication Studies Department, Moody College of Communication, University of Texas at Austin, Austin, TX, United States},
	abstract = {This paper applies indexing theory to test whether U.S. television news about COVID-19 covered misinformed elite viewpoints and whether indexing patterns were consistent across networks. We extend theory by investigating an emerging crisis where information was in flux. We conducted a content analysis of U.S. broadcast and cable news coverage of two COVID-19 issues: masks and disinfectants/UV light. Coverage responded to changes in health institution guidance related to mask wearing, but: (a) mentioning partisan elites was related to misleading content, (b) at times mentioning health institutions was related to decreased inclusion of correct information, and (c) at times patterns of indexing differed across networks. Findings suggest that indexing practices may encourage misinformation spread during emerging crises, especially on partisan news. © 2022 International Communication Association.},
	author_keywords = {content analysis; COVID-19; indexing theory; Misinformation; television},
	correspondence_address = {A. Muddiman; Communication Studies Department, University of Kansas, Lawrence, United States; email: ashley.muddiman@ku.edu},
	publisher = {Routledge},
	issn = {23808985},
	language = {English},
	abbrev_source_title = {Annals Int. Commun. Ass.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

