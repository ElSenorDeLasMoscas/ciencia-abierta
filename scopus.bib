	number = {2},
	pages = {126 - 139},
	doi = {10.1177/0267323119894489},
	url = {https://www.scopus.com/pages/publications/85077196885?origin=resultslist},
	affiliations = {University of Copenhagen, Denmark},
	abstract = {In this article, we question the efforts undertaken by Facebook in regard to fact-checking, tagging, and flagging instances or appearances of fake news. We argue that in a global world of communication, fake news is a form of communicative action, which we must learn to deal with rather than try to remove. The very existence of fake news is a political question inscribing itself in the history of political communication and thus in the long run a question about the democratic conversation. This conversation must and will always be a conversation where arguments (emotional or not) are discussed in a common place. In other words, there is no technical fix, such as automated flagging or tagging, to the ‘solution’ for democratic conversation. We must insist on the democratic value of listening to the other. The outcome can never be one of getting it right by algorithmic means. © The Author(s) 2019.},
