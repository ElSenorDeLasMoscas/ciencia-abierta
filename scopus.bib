@ARTICLE{Pérez-Escoda2021,
	author = {Pérez-Escoda, Ana and Pedrero-Esteban, Luis Miguel and Rubio-Romero, Juana and Jiménez-Narros, Carlos},
	title = {Fake news reaching young people on social networks: Distrust challenging media literacy},
	year = {2021},
	journal = {Publications},
